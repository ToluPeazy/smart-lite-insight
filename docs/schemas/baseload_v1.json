{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Smart-Lite Insight Base-Load Profile Schema",
  "version": "1.0",
  "type": "object",
  "required": ["schema_version", "site_id", "method", "source_range", "slots"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "baseload-1.0"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "method": {
      "type": "string",
      "enum": ["submeter_subtraction", "quantile"]
    },
    "source_range": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      },
      "additionalProperties": false
    },
    "slots": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "object",
        "required": ["slot", "start", "base_load_kw", "base_load_kwh"],
        "properties": {
          "slot": { "type": "integer", "minimum": 0, "maximum": 47 },
          "start": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):(00|30)$"
          },
          "base_load_kw": { "type": "number", "minimum": 0 },
          "base_load_kwh": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
